# Copy to .env.local for a local preview. .env.local is gitignored: channel origins
# other than production's are configuration, never committed.

# Channel for `pnpm dev` and `pnpm prepare:channel` (prod | test).
DOCS_CHANNEL=test

# Test channel: the test environment's API and console.
DOCS_TEST_API_URL=https://api.example.test
DOCS_TEST_CONSOLE_URL=https://console.example.test

# Optional: the release label, while the channel's API does not report the release it runs.
# DOCS_RELEASE=v1.2.3
