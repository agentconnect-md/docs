# Copy to .env.local for a local preview. .env.local is gitignored: a channel's origins are
# configuration, never committed.

# Channel for `pnpm dev` and `pnpm prepare:channel` (prod | test).
DOCS_CHANNEL=test

# The environment the channel documents: its API and its console.
DOCS_API_URL=https://api.example.test
DOCS_CONSOLE_URL=https://console.example.test
